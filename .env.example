# Supabase — grab these from Supabase Dashboard → Project → Settings → API.
# Values are safe to expose to the browser (the anon/publishable key is public).
# Server-side envs (without VITE_ prefix) are only used during SSR.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_OR_PUBLISHABLE_KEY"

VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_OR_PUBLISHABLE_KEY"
