SUPABASE_URL=https://xtvomhbolgrzlkaocyju.supabase.co
# Supabase → Project Settings → API → service_role. Server only, never in the web app.
SUPABASE_SERVICE_ROLE_KEY=
GPS_TCP_PORT=5023
HTTP_PORT=8080
# LOG_RAW=1   # print every packet in hex (debugging a new tracker model)
# Trip alerts (web push to owners' phones). Generate once with `npm run vapid`.
# The public key must equal VAPID_PUBLIC_KEY in src/lib/push.ts of the web app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@livetrack.app
