{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    { "source": "/((?!assets/|api/|icons/|favicon\\.ico|robots\\.txt|.*\\.(?:js|css|map|webmanifest|html|png|jpg|jpeg|svg|gif|webp|ico|woff2?|ttf)$).*)", "destination": "/api/ssr" }
  ]
}
